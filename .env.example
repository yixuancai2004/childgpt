# Server-only configuration. Leave these three fields empty for the offline demo.
# BASE_URL should include the provider's API prefix (often /v1), not /chat/completions.
# Free-tier starter: LLM_BASE_URL=https://api.groq.com/openai/v1 and LLM_MODEL=qwen/qwen3.8-27b
# Create your own key at https://console.groq.com/keys and keep the account on the Free plan.
# Paid alternative: LLM_BASE_URL=https://api.openai.com/v1 and LLM_MODEL=gpt-5.4-mini
# Fill all three values together. Keep the key in this local file, never in the frontend.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# A separate application access token is REQUIRED before exposing a keyed backend.
# Never use the provider API key as this token.
APP_ACCESS_TOKEN=
HOST=127.0.0.1
PORT=8000
LLM_TIMEOUT_MS=15000
# Auto-connect only the server's own localhost page when an LLM is configured.
# Remote hosting still requires the separate application access token.
LOCAL_AUTO_CONNECT=true

# Required only when a separately hosted backend is used from GitHub Pages.
# Comma-separated exact origins, e.g. https://yixuancai2004.github.io
ALLOWED_ORIGINS=
# Optional private writable directory; never publish it.
# DATA_DIR=/private/path/childgpt-sessions
