# Server-only configuration. Leave these three fields empty for the offline demo.
# BASE_URL should include the provider's API prefix (often /v1), not /chat/completions.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# A separate application access token is REQUIRED before exposing a keyed backend.
# Never use the provider API key as this token.
APP_ACCESS_TOKEN=
HOST=127.0.0.1
PORT=8000
LLM_TIMEOUT_MS=15000

# Required only when a separately hosted backend is used from GitHub Pages.
# Comma-separated exact origins, e.g. https://yixuancai2004.github.io
ALLOWED_ORIGINS=
# Optional private writable directory; never publish it.
# DATA_DIR=/private/path/childgpt-sessions
